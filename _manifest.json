{
  "manifest_version": 2,
  "id": "github.cateye.mai-forward",
  "version": "0.1.0",
  "name": "麦麦转发",
  "description": "打包指定消息进行合并/逐条转发与复读：消息内容从 NapCat/宿主数据库原样读取（不从 LLM 文本构造），发送后向目标聊天注入带来源标注（[转发工具 源→目标] / [复读工具]）的聊天记录，并提供 forward_messages / repeat_message 两个 LLM 工具。",
  "author": { "name": "cateye", "url": "https://github.com/cateyemizuki" },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_mai_forward",
    "homepage": "https://github.com/cateyemizuki/cateye_mai_forward",
    "documentation": "https://github.com/cateyemizuki/cateye_mai_forward/blob/main/README.md",
    "issues": "https://github.com/cateyemizuki/cateye_mai_forward/issues"
  },
  "host_application": { "min_version": "1.0.0", "max_version": "1.99.99" },
  "sdk": { "min_version": "2.5.0", "max_version": "2.99.99" },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.emoji",
    "send.hybrid",
    "send.forward",
    "message.get_by_id",
    "chat.get_all_streams",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "chat.open_session",
    "api.call"
  ],
  "i18n": { "default_locale": "zh-CN" },
  "plugin_type": "tool",
  "display": {
    "icon": { "type": "lucide", "value": "forward", "fallback": "➡️" }
  }
}
